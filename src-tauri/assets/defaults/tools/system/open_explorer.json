{
  "$schema": "../../schemas/tool.schema.json",
  "name": "open_explorer",
  "title": { "en": "Open Explorer", "de": "Explorer öffnen" },
  "description": "Opens a folder in Windows Explorer. Without a path, the Downloads folder is opened.",
  "keywords": {"en":"explorer folder files directory","de":"explorer ordner dateien verzeichnis"},
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Folder path, e.g. C:\\Users or shell:Desktop, shell:Documents, shell:Downloads",
        "default": "shell:Downloads"
      }
    }
  },
  "action": {
    "type": "launch",
    "program": "explorer.exe",
    "args": ["{{path}}"]
  }
}