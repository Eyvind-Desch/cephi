{
  "$schema": "../../schemas/tool.schema.json",
  "name": "run_powershell",
  "title": { "en": "PowerShell command", "de": "PowerShell-Befehl" },
  "description": "Runs a PowerShell command and returns its output. Only use this when no more specific tool fits. The user has to confirm every command.",
  "permission": "confirm",
  "parameters": {
    "type": "object",
    "properties": {
      "command": { "type": "string", "description": "The PowerShell command to run" }
    },
    "required": ["command"]
  },
  "action": {
    "type": "powershell",
    "timeoutSecs": 60,
    "script": "Invoke-Expression $env:CEPHI_ARG_COMMAND | Out-String -Width 200"
  }
}