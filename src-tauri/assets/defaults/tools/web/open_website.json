{
  "$schema": "../../schemas/tool.schema.json",
  "name": "open_website",
  "title": "Webseite öffnen",
  "description": "Öffnet eine bestimmte Webseite im Browser, z. B. github.com oder https://example.com.",
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "Vollständige Adresse inklusive https://" }
    },
    "required": ["url"]
  },
  "action": {
    "type": "open_url",
    "url": "{{url|raw}}"
  }
}
