{
  "$schema": "../../schemas/tool.schema.json",
  "name": "open_website",
  "title": { "en": "Open website", "de": "Webseite öffnen" },
  "description": "Opens a specific website in the browser, e.g. github.com or https://example.com.",
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "Full address including https://" }
    },
    "required": ["url"]
  },
  "action": {
    "type": "open_url",
    "url": "{{url|raw}}"
  }
}