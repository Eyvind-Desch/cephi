{
  "$schema": "../../schemas/tool.schema.json",
  "name": "weather",
  "title": { "en": "Weather", "de": "Wetter" },
  "description": "Returns the current weather for a location.",
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "location": { "type": "string", "description": "City or place, e.g. Berlin" }
    },
    "required": ["location"]
  },
  "action": {
    "type": "http",
    "method": "GET",
    "url": "https://wttr.in/{{location}}?format=%l:+%c+%t+(feels+like+%f),+wind+%w,+humidity+%h",
    "timeoutSecs": 10
  }
}