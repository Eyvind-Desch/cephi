{
  "$schema": "../../schemas/tool.schema.json",
  "name": "weather",
  "title": "Wetter",
  "description": "Liefert das aktuelle Wetter und die Vorhersage für einen Ort.",
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "location": { "type": "string", "description": "Stadt oder Ort, z. B. Berlin" }
    },
    "required": ["location"]
  },
  "action": {
    "type": "http",
    "method": "GET",
    "url": "https://wttr.in/{{location}}?format=%l:+%c+%t+(gefühlt+%f),+Wind+%w,+Luftfeuchte+%h&lang=de",
    "timeoutSecs": 10
  }
}
