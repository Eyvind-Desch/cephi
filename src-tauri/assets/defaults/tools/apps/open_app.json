{
  "$schema": "../../schemas/tool.schema.json",
  "name": "open_app",
  "title": { "en": "Launch app", "de": "App starten" },
  "description": "Starts an installed program or app, e.g. Discord, Steam, Excel or Calculator. The name may be inexact.",
  "permission": "auto",
  "parameters": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "description": "Name of the app, e.g. 'Discord'" }
    },
    "required": ["name"]
  },
  "triggers": [
    "(öffne|öffnen|starte|start|open|launch|run) [(den|die|das|the)] [(app|programm|program)] {name}",
    "{name} (öffnen|starten)"
  ],
  "action": {
    "type": "builtin",
    "id": "open_app"
  }
}